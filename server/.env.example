# Node API database settings for local development.
# On a NEW checkout, copy this template to server/.env.
# Set PGPASSWORD to the password assigned to textrank_app.
# Do not use the PostgreSQL administrator account here.
# Never put real passwords in this example.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=textrank
PGUSER=textrank_app
PGPASSWORD=